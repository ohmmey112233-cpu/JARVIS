# =============================================================================
# Jarvis Phase 0B — ค่าลับที่ต้องกรอกเอง
# =============================================================================
# วิธีใช้:
#   cp config/jarvis.env.example config/jarvis.env
#   nano config/jarvis.env          # กรอกค่าให้ครบ 3 ตัวแรก
#   bash scripts/02-configure-jarvis.sh
#
# ⚠ ไฟล์ config/jarvis.env ถูก .gitignore ไว้แล้ว — ห้าม commit เข้า git เด็ดขาด
#   สคริปต์ขั้นที่ 2 จะคัดลอกค่าพวกนี้ไปไว้ที่ ~/.hermes/.env (chmod 600)
# =============================================================================

# --- 1. สมองของ Jarvis: Claude (Anthropic API) -------------------------------
# หาได้ที่ https://console.anthropic.com → Settings → API Keys → Create Key
# ⚠ H2 จาก red team: ตรวจก่อนว่าใครเป็นคนเปิดบัญชี/ผูกบัตร (เรื่องอายุผู้บรรลุนิติภาวะ)
ANTHROPIC_API_KEY=

# --- 2. Telegram bot ---------------------------------------------------------
# หาได้จาก @BotFather ในแอป Telegram:
#   /newbot → ตั้งชื่อที่แสดง → ตั้ง username (ต้องลงท้ายด้วย bot) → ได้ token
# หน้าตาแบบนี้: 123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_TOKEN=

# --- 3. Telegram user ID ของโอม ----------------------------------------------
# ทักหา @userinfobot ในแอป Telegram แล้วมันจะตอบเลข ID กลับมาทันที
# ⚠ ต้องเป็น "ตัวเลข" ไม่ใช่ @username
# ถ้ามีหลายคน คั่นด้วยคอมมา: 123456789,987654321
# นี่คือด่านกันคนอื่นคุยกับบอทเรา — ถ้าเว้นว่าง ใครก็สั่ง Jarvis ได้
TELEGRAM_ALLOWED_USERS=

# =============================================================================
# ค่าด้านล่างมีค่า default ที่ใช้ได้เลย — แก้เฉพาะเมื่อรู้ว่าจะแก้อะไร
# =============================================================================

# --- โมเดลหลัก ---------------------------------------------------------------
# ราคาต่อ 1 ล้าน token (input/output):
#   claude-opus-5    $5 / $25    ← ค่า default: ฉลาดที่สุด
#   claude-sonnet-5  $3 / $15    ← ถูกกว่าราว 40% (ช่วงโปรถึง 31 ส.ค. 2026: $2/$10)
#
# ⚠ spec ตั้งงบ Claude API ไว้ $2-10/เดือน — ถ้าคุยเยอะทุกวัน opus-5 มีสิทธิ์เกินงบ
#   ถ้าอยากคุมงบให้อยู่ ให้เปลี่ยนบรรทัดล่างเป็น claude-sonnet-5 ก่อนรันขั้นที่ 2
#   (เปลี่ยนทีหลังก็ได้:  hermes config set model.default claude-sonnet-5)
#   ตัดสินใจได้ชัดขึ้นหลัง gate trial 3 วัน — ดูค่าใช้จ่ายจริงด้วย /usage ในแชท
JARVIS_MODEL=claude-opus-5

# --- โมเดลผู้ช่วย (งานจำแนกสั้นๆ) ---------------------------------------------
# spec ข้อ "ตัวจำแนกงานสั้นๆ ใช้ Haiku ประหยัดกว่า" — Hermes ทำให้อัตโนมัติแล้ว
# เมื่อ provider=anthropic มันเลือก claude-haiku-4-5 เป็น aux model ให้เอง
# ไม่ต้องตั้งอะไรเพิ่ม เว้นว่างไว้ = ใช้ค่า default ของ Hermes
JARVIS_AUX_MODEL=

# --- timezone ----------------------------------------------------------------
# กฎเหล็กข้อ 3 ของ spec: ทุกอย่างต้องอ้างเวลาไทย ห้ามเป็น UTC
# เที่ยงคืน UTC = 7 โมงเช้าไทย ถ้าพลาดข้อนี้ digest/routine จะมาผิดเวลาทุกวัน
JARVIS_TIMEZONE=Asia/Bangkok
